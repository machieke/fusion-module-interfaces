{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "httpsPort",
    "testFaultsEnabled",
    "components"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Never"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "httpsPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "testFaultsEnabled": {
      "type": "boolean"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omega-agent",
        "fusion-execution",
        "fusion-storage",
        "fusion-messaging"
      ],
      "properties": {
        "omega-agent": {
          "$ref": "#/definitions/component"
        },
        "fusion-execution": {
          "$ref": "#/definitions/component"
        },
        "fusion-storage": {
          "$ref": "#/definitions/component"
        },
        "fusion-messaging": {
          "$ref": "#/definitions/component"
        },
        "fusion-search": {
          "$ref": "#/definitions/component"
        },
        "fusion-embedding": {
          "$ref": "#/definitions/component"
        },
        "fusion-model": {
          "$ref": "#/definitions/component"
        },
        "fusion-channel-bridge": {
          "$ref": "#/definitions/component"
        },
        "irc-server": {
          "$ref": "#/definitions/component"
        },
        "irc-peer": {
          "$ref": "#/definitions/component"
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "corpus": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "creation_clock_fixture": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "query_vector_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "expected_feedback": {
          "type": "object"
        },
        "clock_fixture": {
          "type": "number"
        },
        "invocation_timeout_ms": {
          "const": 30000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "scope",
              "session",
              "corpus",
              "model",
              "inputs",
              "queries",
              "query_vector_hashes",
              "responses",
              "invocation_timeout_ms"
            ]
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "const": "recorded"
        },
        "liveEnabled": {
          "const": false
        },
        "phase": {
          "enum": [
            "setup",
            "measured"
          ]
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "modelScope": {
          "type": "string",
          "minLength": 1
        },
        "channelScope": {
          "type": "string",
          "minLength": 1
        },
        "bridge": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "followup": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "bodies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "responses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "enabled",
              "mode",
              "liveEnabled",
              "phase",
              "session",
              "modelScope",
              "channelScope",
              "bridge",
              "target",
              "question",
              "followup",
              "query",
              "recipient",
              "bodies",
              "responses"
            ]
          }
        }
      ]
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "persistence",
        "resources",
        "config"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storageClass",
            "size"
          ],
          "properties": {
            "storageClass": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "limits",
            "requests"
          ],
          "properties": {
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            }
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "capacity",
            "nativeEnabled",
            "workerEnabled",
            "test"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "nativeEnabled": {
              "type": "boolean"
            },
            "workerEnabled": {
              "type": "boolean"
            },
            "test": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pause_at": {
                  "enum": [
                    "after_call_reservation",
                    "after_submit_reply",
                    "after_caller_receipt",
                    "after_output_commit",
                    "after_result_persist",
                    "after_delivery_accept",
                    "after_memory_vector_capture",
                    "after_append_enrollment_acceptance",
                    "after_native_result_capture",
                    "after_candidate_capture",
                    "after_payload_validation",
                    "after_index_write",
                    "before_checkpoint",
                    "after_checkpoint",
                    "after_publication",
                    "after_encoder_evaluation",
                    "after_encoder_reservation",
                    "after_vector_capture",
                    "after_append_publication",
                    "after_append_metadata",
                    "after_append_enrollment",
                    "after_append_view_selection",
                    "after_model_reservation",
                    "after_model_capture",
                    "after_model_prompt_bind",
                    "after_model_provider_reply",
                    "after_model_application_capture",
                    "after_channel_input_commit",
                    "after_channel_ack_reply",
                    "after_bridge_capture",
                    "after_bridge_egress_commit",
                    "after_socket_reservation",
                    "after_socket_write",
                    "after_turn_commit",
                    "after_model_provider_capture",
                    "after_application_input_commit",
                    "after_application_input_ack_reply",
                    "after_occurrence_bind",
                    "after_model_rpc_reservation"
                  ]
                },
                "drop_response_operation": {
                  "enum": [
                    "submit",
                    "/ports/atom-create",
                    "/ports/completion",
                    "create",
                    "observe",
                    "build",
                    "published",
                    "encode",
                    "query",
                    "getMany",
                    "complete",
                    "send",
                    "ack"
                  ]
                },
                "pause_slot": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                }
              }
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/properties/image"
        }
      }
    }
  }
}
