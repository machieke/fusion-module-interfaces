import subprocess,json,time
from pathlib import Path
ROOT=Path('@@PRIVATE_ROOT@@/preparation');OUTPUT=Path('@@PRIVATE_ROOT@@');ENV=dict(HOME=str(ROOT/'user-home'),PATH='@@NODE_BIN@@:/usr/bin:/bin',AGENT_BROWSER_SESSION='@@BROWSER_SESSION@@',AGENT_BROWSER_SOCKET_DIR='@@BROWSER_SOCKET_DIR@@',AGENT_BROWSER_EXECUTABLE_PATH='@@BROWSER_EXECUTABLE@@')
def run(*args):
 r=subprocess.run(['@@PROOFSHOT@@','exec',*args],cwd=ROOT/'user-client',env=ENV,text=True,capture_output=True,timeout=25)
 if r.returncode:raise RuntimeError(r.stdout+r.stderr)
 return r.stdout.strip()
def value(expression):return json.loads(json.loads(run('eval','JSON.stringify('+expression+')')))
def click(selector):run('scrollintoview',selector);run('click',selector);time.sleep(.25)
def dump(name,value):
 p=OUTPUT/name
 assert not p.exists(),name
 p.write_text(json.dumps(value,sort_keys=True,indent=2)+'\n')
def modal(selector):run('eval','setTimeout(()=>document.querySelector('+json.dumps(selector)+').click(),1500); "NORMAL_BUTTON_CLICK_SCHEDULED"');time.sleep(1.7);run('dialog','accept');time.sleep(.2)
