import json,subprocess,secrets,base64,hashlib,os
from pathlib import Path
os.umask(0o077);root=Path('@@PRIVATE_ROOT@@/owner-credential-renewal');root.mkdir(exist_ok=False);old=Path('@@PRIVATE_ROOT@@/preparation/secrets');k=['@@KUBECTL@@','--kubeconfig','@@KUBECONFIG@@','--context','default','-n','@@NAMESPACE@@'];r=json.loads(subprocess.check_output(k+['get','secret','omega-agent-tls-auth','-o','json']));(root/'before-secret.json').write_text(json.dumps(r));before=dict(r['data']);new=secrets.token_urlsafe(32)
(root/'extensions').write_text('subjectAltName=DNS:omega-agent.@@NAMESPACE@@.svc.cluster.local\nextendedKeyUsage=serverAuth\nbasicConstraints=critical,CA:FALSE\n')
def run(*args):subprocess.run(['openssl',*args],check=True,cwd=root,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
run('req','-newkey','rsa:2048','-nodes','-keyout','omega-agent.key','-out','omega-agent.csr','-subj','/CN=omega-agent')
run('x509','-req','-in','omega-agent.csr','-CA',str(old/'ca.crt'),'-CAkey',str(old/'ca.key'),'-CAcreateserial','-out','omega-agent.crt','-days','7','-extfile','extensions')
# Existing recipe's key names are inspected before changing exact three items.
assert {'tls.crt','tls.key','browser-shared-token'}<=set(before)
patch={'data':{'tls.crt':base64.b64encode((root/'omega-agent.crt').read_bytes()).decode(),'tls.key':base64.b64encode((root/'omega-agent.key').read_bytes()).decode(),'browser-shared-token':base64.b64encode(new.encode()).decode()}};(root/'patch.json').write_text(json.dumps(patch));subprocess.run(k+['patch','secret','omega-agent-tls-auth','--type','merge','--patch-file',str(root/'patch.json')],check=True)
(root/'report.json').write_text(json.dumps(dict(state='SECRET_UPDATED_POD_RESTART_REQUIRED',ca_sha256=hashlib.sha256(base64.b64decode(before['ca.crt'])).hexdigest(),old_leaf_sha256=hashlib.sha256(base64.b64decode(before['tls.crt'])).hexdigest(),new_leaf_sha256=hashlib.sha256((root/'omega-agent.crt').read_bytes()).hexdigest(),scoped_principal='browser-shared',changed_keys=sorted(patch['data']),business_inputs=0),indent=2)+'\n')
print('Same-CA leaf and exact scoped owner credential rotated; no work submitted.')
