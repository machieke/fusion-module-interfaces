  "development_and_failure_notes": [
    {
      "identity": "initial packaged kernel probe",
      "outcome": "FAILED_INVOCATION",
      "reason": "The diagnostic imported nonexistent now_ms. Corrected time.time-based invocation executed the real original kernel and returned the original golden representation."
    },
    {
      "identity": "initial regression: 22 methods",
      "outcome": "21_PASS_1_FAIL",
      "reason": "Python 3.12 decoded depth-1500 JSON instead of raising the historical recursion error. Added explicit depth bound; final regression passes."
    },
    {
      "identity": "initial omega-single-node deployment / dev-02",
      "outcome": "TLS_PREREQUISITE_FAILED",
      "reason": "Demo CA had duplicate BasicConstraints inherited from host OpenSSL config. Peer verification refused it; no native invocation. Explicit CA config and per-leaf openssl verify fixed setup. Wrong k3s ctr invocation was corrected to the container ctr executable."
    },
    {
      "identity": "tests-01",
      "outcome": "2_PASS_8_FAIL",
      "reason": "Seven completed workflows rejected by incorrect test receipt field backend instead of provider; outage observer waited too briefly for scale-down. Raw reports preserved, not relabelled."
    },
    {
      "identity": "tests-02",
      "outcome": "8_PASS_3_FAIL",
      "reason": "Health snapshot raced provider scheduling; storage outage and scale-down observer assumptions were invalid. Initial provider-replacement PASS did not prove a pause after output because namespace PID 1 ignored self-SIGSTOP. Superseded by explicit barrier evidence."
    },
    {
      "identity": "tests-03",
      "outcome": "2_PASS_2_FAIL",
      "reason": "Storage case confirmed ineffective PID-1 SIGSTOP barrier. Empty-service outage reached the original deadline at 27 calls, rather than the test-expected 64. Reported provider PASS still lacked the intended pause; do not count it as that gate."
    },
    {
      "identity": "tests-04",
      "outcome": "3_PASS",
      "reason": "Explicit worker-thread kill barrier proves queued + captured output before real pod replacement. Storage EndpointSlice outage recovered. Non-listening target-port outage exhausted exactly 64 calls and stayed failed after replacement."
    },
    {
      "identity": "final image import first invocation",
      "outcome": "FAILED_IMPORT",
      "reason": "Import was attempted before Docker archive export finished; ctr rejected unrecognized format. Completed archive imported successfully; final archive digest and image identities recorded."
    },
    {
      "identity": "tests-final",
      "outcome": "9_PASS_2_SETUP_FAIL",
      "reason": "Two long namespace DNS names exceeded the X.509 CN 64-byte limit before workloads were installed. Fixed demo leaf CN to short role while retaining full verified DNS SAN; immutable application image unchanged."
    },
    {
      "identity": "tests-final-r2",
      "outcome": "2_PASS",
      "reason": "Fresh longer namespace names exercise corrected certificate helper and both replacement scenarios against the unchanged final image."
    }
  ],
  "live_generations": 0
}
